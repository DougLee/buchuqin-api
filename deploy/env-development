# =====================================================================
# 不出寝食社 · 环境变量模板（依据 2026-10-11 测试环境 .env 整理）
# 用法：cp deploy/env-development .env && 逐项填值
# 约定：①compose 会用 PSQL_HOST+POSTGRES_PASSWORD 拼出 DATABASE_URL 注入容器，
#         覆盖 .env 里的同名键——.env 里【不要】再写 DATABASE_URL，防主机名过期造成误解；
#       ②密钥类一律 600 权限、不入 git；③标 [仅测试] 的键生产环境禁用。
# =====================================================================

# ------------------ ① 数据库与核心（必填） ------------------
# PG 容器名（1Panel 应用商店装的 PostgreSQL，docker ps 查名字）
PSQL_HOST=1Panel-postgresql-xxxx
# buchuqin 数据库角色密码（compose 拼接 DATABASE_URL 用；建库时 CREATE ROLE 的密码）
POSTGRES_PASSWORD=<24位左右强密码>
# JWT 签名密钥（HS256；openssl rand -hex 32 生成，每环境独立）
JWT_SECRET=<openssl rand -hex 32>
# API 监听端口（compose 已固定 3000，一般不用动）
PORT=3000

# ------------------ ② 腾讯云 COS 图片存储（必填） ------------------
COS_SECRET_ID=<腾讯云 SecretId>
COS_SECRET_KEY=<腾讯云 SecretKey>
COS_BUCKET=<bucket名-appid>
COS_REGION=ap-guangzhou
# 图片公网访问域名（COS 自定义 CDN/加速域名）
COS_PUBLIC_BASE_URL=https://static.example.com
# 本地磁盘上传兜底通道（生产保持 false，走 COS）
LOCAL_UPLOADS_ENABLED=false

# ------------------ ③ 微信小程序（必填，两套小程序各一对） ------------------
# 骑手/楼长小程序
WX_APPID_DELIVERY=<appid>
WX_SECRET_DELIVERY=<appsecret>
# 用户小程序
WX_APPID_USER=<appid>
WX_SECRET_USER=<appsecret>
# [兼容] 无后缀的 WX_APPID/WX_SECRET 历史上等于骑手小程序，新环境可不配

# ------------------ ④ 微信支付（接支付必填；不接可整段留空） ------------------
# 商户号
WX_MCH_ID=<mchid>
# APIv3 密钥（恰好 32 位，长一位短一位都 ERR_CRYPTO_INVALID_KEYLEN）
WX_APIV3_KEY=<32位APIv3密钥>
# 商户 API 证书序列号（40 位 hex，openssl x509 -in apiclient_cert.pem -serial 提取；
# 注意≠微信支付公钥序列号 PUB_KEY_ID_ 开头那个）
WX_SERIAL_NO=<40位hex>
# 商户私钥（apiclient_key.pem 单行化：awk 'NF {printf "%s\\n", $0}' 文件）
WX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<单行化私钥>\n-----END PRIVATE KEY-----\n"
# 支付回调地址（必须与本环境对外域名一致；测试=测试域名，生产=生产域名）
WX_NOTIFY_URL=https://<本环境域名>/api/v1/payments/wechat/notify
# 微信支付公钥模式（道哥商户是公钥模式，pub_key.pem 单行化；账户中心→API安全→微信支付公钥下载）
WX_WXPAY_PUBLIC_KEY_ID="PUB_KEY_ID_xxxxxxxx"
WX_WXPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<单行化公钥>\n-----END PUBLIC KEY-----\n

# ------------------ ⑤ 订阅消息与服务号推送 ------------------
# 订阅消息模板 ID（支付成功/已送达，微信后台申请）
WX_TMPL_PAID=<模板ID>
WX_TMPL_DELIVERED=<模板ID>
# 服务号（骑手派单推送）
WX_GZH_APPID=<服务号appid>
WX_GZH_SECRET=<服务号secret>
WX_GZH_TOKEN=<服务器Token>
WX_GZH_TEMPLATE_ID=<模板ID>

# ------------------ ⑥ 云打印（芯烨云，可选） ------------------
XPYUN_USER=<芯烨云账号>
XPYUN_USERKEY=<芯烨云密钥>
# 打印机 SN 留空=走后台按校区绑定流程；写死=全局绑定（测试隔离时曾注释此键）
# XPYUN_PRINTER_SN=<SN>

# ------------------ ⑦ 运营与开关 ------------------
# 定时红包券（新人定时发券活动的券 ID）
SCHEDULED_BONUS_COUPON_ID=<coupon-id>
# [仅测试] 测试登录通道（免微信静默登录直连），生产必须 false 或删除！
ALLOW_TEST_LOGIN=false
# 同账号单设备登录（新登录踢旧会话）
ADMIN_SINGLE_SESSION=true
# Swagger 文档（生产 false）
SWAGGER_ENABLED=false

# =====================================================================
# ⚠️ 千万不要出现的键：
#   SEED_ON_BOOT=true   —— 演示数据开关，seed 开头会清库！
# =====================================================================
