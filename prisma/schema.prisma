generator client {
  provider = "prisma-client-js"
}

// 金额单位总则（IK8W5K）：全 API 金额字段统一为整数分（Int），字段名不变；
// 仅 weight / onTimeRate / proofRate 等非金额维度保留 Decimal。

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campus {
  id            String    @id @default(cuid())
  name          String
  shortName     String
  warehouseName String
  address       String?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  users         User[]
  products      Product[]
  addresses     Address[]
  orders        Order[]
  staff         Staff[]
}

model User {
  id            String         @id @default(cuid())
  campusId      String
  campus        Campus         @relation(fields: [campusId], references: [id])
  nickname      String
  phone         String
  avatar        String         @default("")
  role          String         @default("user")
  openid        String?        @unique
  createdAt     DateTime       @default(now())
  addresses     Address[]
  cartItems     CartItem[]
  orders        Order[]
  notifications Notification[]
  afterSales    AfterSale[]
  refunds       Refund[]
  userCoupons   UserCoupon[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  sort     Int       @default(0)
  products Product[]
}

model Product {
  id            String     @id @default(cuid())
  barcode       String?    @unique
  campusId      String
  campus        Campus     @relation(fields: [campusId], references: [id])
  categoryId    String
  category      Category   @relation(fields: [categoryId], references: [id])
  name          String
  subtitle      String
  price         Int // 金额单位:分（IK8W5K）
  originalPrice Int
  stock         Int
  lockedStock   Int        @default(0)
  sales         Int        @default(0)
  tag           String
  image         String
  weight        Decimal    @db.Decimal(10, 3)
  status        String     @default("on-sale")
  cartItems     CartItem[]
  inventoryTxns InventoryTxn[]
}

model InventoryTxn {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String
  delta     Int
  reason    String
  operator  String
  createdAt DateTime @default(now())
}

model Banner {
  id       String  @id @default(cuid())
  campusId String
  title    String
  subtitle String
  badge    String
  color    String
  image    String?
  sort     Int     @default(0)
  status   String  @default("active")
}

model Building {
  id          String   @id @default(cuid())
  campusId    String
  name        String
  floors      Int      @default(6)
  hasElevator Boolean  @default(false)
  gender      String   @default("mixed")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  rooms       Room[]
  staff       Staff[]
}

model Room {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  floor      Int
  roomNo     String
  qrToken    String   @unique
  createdAt  DateTime @default(now())

  @@unique([buildingId, floor, roomNo])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  campusId     String
  campus       Campus  @relation(fields: [campusId], references: [id])
  campusName   String
  buildingId   String
  buildingName String
  floor        Int
  room         String
  contactName  String
  phone        String
  isDefault    Boolean @default(false)
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([userId, productId])
}

model Coupon {
  id           String        @id @default(cuid())
  campusId     String
  name         String
  amount       Int // 金额单位:分
  threshold    Int
  total        Int           @default(0)
  status       String
  expiresAt    DateTime
  issued       Int           @default(0)
  claimed      Int           @default(0)
  used         Int           @default(0)
  userCoupons  UserCoupon[]
}

model UserCoupon {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  status    String   @default("claimed")
  claimedAt DateTime @default(now())
}

model DeliverySlot {
  id        String  @id @default(cuid())
  campusId  String
  label     String
  available Boolean @default(true)
  capacity  Int     @default(100)
}

model Order {
  id                String      @id @default(cuid())
  riderId           String?
  orderNo           String      @unique
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  campusId          String
  campus            Campus      @relation(fields: [campusId], references: [id])
  status            String
  statusText        String
  createdAt         DateTime    @default(now())
  paidAt            DateTime?
  address           Json
  deliveryMode      String
  deliverySlot      String?
  couponId          String?
  remark            String      @default("")
  items             Json
  productAmount     Int
  totalQuantity     Int
  deliveryThreshold Int
  deliveryFee       Int
  discount          Int
  payableAmount     Int
  estimatedArrival  String
  timeline          Json
  package           Json?
  stockRestored     Boolean     @default(false)
  afterSales        AfterSale[]
  refunds           Refund[]
  commissions       Commission[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AfterSale {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  type        String
  description String
  images      Json
  status      String
  createdAt   DateTime @default(now())
}

model Refund {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Int
  reason    String
  status    String
  createdAt DateTime @default(now())
}

model Staff {
  id                  String               @id @default(cuid())
  campusId            String
  campus              Campus               @relation(fields: [campusId], references: [id])
  name                String
  role                String
  roleText            String
  staffNo             String               @unique
  buildingId          String?
  buildingRef         Building?            @relation(fields: [buildingId], references: [id])
  building            String
  status              String               @default("online")
  completedToday      Int                  @default(0)
  onTimeRate          Decimal              @db.Decimal(5, 2)
  proofRate           Decimal?             @db.Decimal(5, 2)
  income              Int
  leaveRequests       LeaveRequest[]
  dispatchInvitations DispatchInvitation[]
  commissions         Commission[]
  bills               BmBill[]
}

model LeaveRequest {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  startAt    DateTime
  endAt      DateTime
  reason     String
  status     String
  statusText String
  createdAt  DateTime @default(now())
}

model DispatchInvitation {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  buildingId String? // IK8W5Y：调配目标楼栋（admin 创建时写入，履约端只读展示）
  building   String
  startAt    DateTime
  endAt      DateTime
  reward     Int
  status     String
  statusText String
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  campusId   String
  operator   String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}

/** 提成规则（IK8W5L）：楼栋/楼层/重量档/配送模式四维组合 → 单价，版本号供快照引用。 */
model CommissionRule {
  id          String        @id @default(cuid())
  campusId    String
  buildingId  String? // 楼栋维度，null=不限
  floor       Int? // 楼层维度，null=不限
  weightFrom  Decimal?      @db.Decimal(10, 3) // 重量档下界（kg），null=不限
  weightTo    Decimal?      @db.Decimal(10, 3) // 重量档上界（kg），null=不限
  mode        String? // instant|scheduled，null=不限
  price       Int
  version     Int // 校园内递增版本号（Commission 快照引用）
  status      String        @default("active") // active|disabled
  effectiveAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  commissions Commission[]
}

/** 提成记录（IK8W5L）：订单送达时按规则快照生成；退款跨期调整记负向 amount。 */
model Commission {
  id          String          @id @default(cuid())
  staffId     String
  staff       Staff           @relation(fields: [staffId], references: [id])
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id])
  campusId    String
  ruleId      String?
  rule        CommissionRule? @relation(fields: [ruleId], references: [id])
  ruleVersion Int?
  amount      Int // 金额单位:分，可为负（跨期调整）
  kind        String          @default("commission") // commission|adjustment（负向调整独立成行）
  status      String          @default("pending") // pending|settled|adjusted
  fallback    Boolean         @default(false) // 无匹配规则时按 COMMISSION_PER_ORDER 兜底
  period      String // 归属月 YYYY-MM（结算周期）
  remark      String          @default("")
  createdAt   DateTime        @default(now())

  @@unique([orderId, staffId, kind])
}

/** 楼长/骑手月度账单（IK8W5L）：底薪 + 提成合计 + 调整 → 应发。 */
model BmBill {
  id              String    @id @default(cuid())
  staffId         String
  staff           Staff     @relation(fields: [staffId], references: [id])
  campusId        String
  period          String // YYYY-MM
  baseSalary      Int
  commissionTotal Int
  adjustment      Int
  payable         Int
  status          String    @default("pending-review") // pending-review|confirmed|paid
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?
  paidAt          DateTime?

  @@unique([staffId, period])
}
