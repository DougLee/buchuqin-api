# 本地开发数据库（服务器部署时 compose 会用 POSTGRES_PASSWORD 拼接注入同 DATABASE_URL，无需手填）
DATABASE_URL="postgresql://buchuqin:buchuqin_dev_password@localhost:5433/buchuqinshishe?schema=public"
JWT_SECRET="replace-with-a-long-random-secret-before-production"
# 运行环境：production 时 Swagger/本地 uploads 静态目录默认关闭
NODE_ENV=development
PORT=3000
CORS_ORIGINS="http://localhost:5190,http://localhost:5174,http://localhost:5188"
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET=""
COS_REGION=""
# 使用自定义域名/CDN 时填写（不填则用 https://${COS_BUCKET}.cos.${COS_REGION}.myqcloud.com）
# COS_PUBLIC_BASE_URL="https://cdn.example.com"
# API 容器托管管理后台静态站的目录（本地开发留空即可）
# ADMIN_DIST_DIR=/app/admin-dist
# Swagger /docs 开关：默认仅开发开启；生产需显式置 true 才暴露
SWAGGER_ENABLED=true
# 本地 uploads 静态目录开关（历史图片访问通道）：默认仅开发开启，生产关闭
LOCAL_UPLOADS_ENABLED=true
# SEED_ON_BOOT=true 时容器启动会灌入演示数据。危险：库里已有校园数据会跳过（seed 有守卫），
# 但空库误开会在生产写入全套测试用户/订单/券，生产环境保持注释或 false
# SEED_ON_BOOT=false

# ---- 微信生态（IK8W5H / IK8W5I）----
# 小程序登录（wx.code2Session）：双小程序各一对凭证，客户端登录时带 appid 路由；
# 全部为空时 POST /auth/wechat-login 返回 501，不回退 test-login
# 用户端小程序
WX_APPID_USER=""
WX_SECRET_USER=""
# 履约端小程序
WX_APPID_DELIVERY=""
WX_SECRET_DELIVERY=""
# 旧单对配置（兼容，双对齐备时可不配）
WX_APPID=""
WX_SECRET=""
# 微信支付 v3（商户号侧）：任一为空时 POST /payments/wechat/prepay 与回调返回 501
# （ADR-0004：演示支付通道已删除，无 mock 回退）。appid 复用上方 WX_APPID_USER。
# WX_MCH_ID=""
# WX_APIV3_KEY=""
# WX_SERIAL_NO=""          # 商户 API 证书序列号
# WX_PRIVATE_KEY_PATH=""   # 商户私钥 PEM 文件路径（apiclient_key.pem）
# WX_NOTIFY_URL=""         # 支付回调地址（https，须公网可达，如 https://buchuqin.kaola101.com/api/v1/payments/wechat/notify）
# ---- 微信支付公钥（仅 2024+ 新入驻商户需要：平台只有公钥、无平台证书）----
# 商户平台「账户中心→API安全→微信支付公钥」下载，同页可复制公钥序列号（PUB_KEY_ID_ 开头）。
# 配了这两项回调验签走公钥；不配走平台证书自动下载（老商户），两种模式兼容。
# WX_WXPAY_PUBLIC_KEY=""     # 公钥 PEM（可多行，或 awk 单行 \n 转义后单行）
# WX_WXPAY_PUBLIC_KEY_ID=""  # PUB_KEY_ID_… 序列号

# ---- 消息通知渠道（IK8W5M，全部 env 门控、未配置静默跳过）----
# 小程序订阅消息模板 ID（ADR-0004 精简为 2 条；凭证复用上方 WX_APPID_USER/WX_SECRET_USER，
# 公众平台「订阅消息→我的模板」申请通过后把模板 ID 填进来即生效）
# WX_TMPL_PAID=""         # 支付成功通知
# WX_TMPL_DELIVERED=""    # 送达提醒
# 短信兜底（已送达/退款结果；服务商接入点已预留，见 notifications.service.ts TODO）
# SMS_ENABLED="false"
# 楼长企微（自建应用；userid 映射未就绪前先发到测试接收人）
# WECOM_CORPID=""
# WECOM_CORPSECRET=""
# WECOM_AGENTID=""
# WECOM_TEST_USERID=""
